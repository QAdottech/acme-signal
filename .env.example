# Optional — verification emails are skipped when unset
RESEND_API_KEY=

# App URL for email links (defaults to http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile — use test keys locally (always pass):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Supabase — copy these from `npx supabase status` after `pnpm db:start`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
