# Optional — verification emails are skipped when unset
RESEND_API_KEY=

# App URL for email links (defaults to http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — enable the map preview on organization pages with a browser-restricted
# Google Maps Embed API key. Without it, the Google Maps link is still available.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Cloudflare Turnstile — use test keys locally (always pass):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
